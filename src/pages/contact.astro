---
// src/pages/contact.astro
import Base from "../layouts/Base.astro";
---

<Base
  title="Contact Us — Giftly Lists"
  description="Get in touch with the Giftly Lists team. We'll respond as quickly as we can."
  canonicalPath="/contact/"
>
  <!-- Breadcrumb structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://giftlylists.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Contact",
          item: "https://giftlylists.com/contact/",
        },
      ],
    })}
  />

  <!-- ContactPage structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      mainEntity: {
        "@type": "Organization",
        name: "Giftly Lists",
        email: "support@giftlylists.com",
        url: "https://giftlylists.com",
      },
    })}
  />

  <!-- Page Header -->
  <section class="relative pt-32 pb-12 sm:pt-40 sm:pb-16">
    <div class="absolute inset-0" aria-hidden="true">
      <div
        class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-[#D90701]/[0.02] rounded-full blur-[120px]"
      >
      </div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back Link -->
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-[#D90701] transition-colors duration-200 mb-8 group"
      >
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to home
      </a>

      <!-- Title -->
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        Get in touch
      </h1>
      <p class="text-lg text-gray-500 max-w-xl">
        We'd love to hear from you. Send us a message and we'll respond as soon
        as possible.
      </p>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="relative pb-24 sm:pb-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Form card -->
        <div class="lg:col-span-2">
          <div
            class="rounded-3xl border border-white/[0.08] bg-white/[0.02] p-8 sm:p-10"
          >
            <h2 class="text-xl font-semibold text-white mb-8">
              Send a message
            </h2>

            <!-- 
              Replace the action URL with your own form handling service 
              (Formspree, Web3Forms, etc.) or use a mailto: fallback.
              The form below uses a placeholder that will POST to nowhere;
              you must set a real endpoint.
            -->
            <form
              action="https://api.web3forms.com/submit"
              method="POST"
              class="space-y-6"
            >
              <input
                type="hidden"
                name="access_key"
                value="da844447-1813-4ffc-be00-7e41b549cb58"
              />
              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label
                    for="name"
                    class="block text-sm font-medium text-gray-400 mb-2"
                  >
                    Name
                  </label>
                  <input
                    type="text"
                    name="name"
                    id="name"
                    required
                    class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-[#D90701] focus:ring-1 focus:ring-[#D90701] transition-all duration-200"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label
                    for="email"
                    class="block text-sm font-medium text-gray-400 mb-2"
                  >
                    Email
                  </label>
                  <input
                    type="email"
                    name="email"
                    id="email"
                    required
                    class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-[#D90701] focus:ring-1 focus:ring-[#D90701] transition-all duration-200"
                    placeholder="you@example.com"
                  />
                </div>
              </div>

              <div>
                <label
                  for="subject"
                  class="block text-sm font-medium text-gray-400 mb-2"
                >
                  Subject
                </label>
                <input
                  type="text"
                  name="subject"
                  id="subject"
                  required
                  class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-[#D90701] focus:ring-1 focus:ring-[#D90701] transition-all duration-200"
                  placeholder="How can we help?"
                />
              </div>

              <div>
                <label
                  for="message"
                  class="block text-sm font-medium text-gray-400 mb-2"
                >
                  Message
                </label>
                <textarea
                  name="message"
                  id="message"
                  rows="5"
                  required
                  class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-[#D90701] focus:ring-1 focus:ring-[#D90701] transition-all duration-200 resize-none"
                  placeholder="Tell us what's on your mind..."></textarea>
              </div>

              <button
                type="submit"
                class="inline-flex items-center gap-2 bg-[#D90701] hover:bg-[#BF0600] text-white px-7 py-3.5 rounded-xl font-medium text-sm transition-all duration-200 active:scale-[0.98]"
              >
                Send message
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </button>
            </form>
          </div>
        </div>

        <!-- Sidebar info -->
        <div class="space-y-6">
          <!-- Email card -->
          <div
            class="rounded-3xl border border-white/[0.08] bg-white/[0.02] p-6 sm:p-8"
          >
            <div
              class="w-10 h-10 bg-white/[0.03] border border-white/[0.06] rounded-xl flex items-center justify-center mb-4"
            >
              <svg
                class="w-5 h-5 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-base font-semibold text-white mb-2">
              Email us directly
            </h3>
            <a
              href="mailto:support@giftlylists.com"
              class="text-sm text-[#D90701] hover:underline break-all"
            >
              support@giftlylists.com
            </a>
            <p class="text-xs text-gray-600 mt-2">
              Prefer to write? We read every message and typically reply within
              a few hours.
            </p>
          </div>

          <!-- App download card -->
          <div
            class="rounded-3xl border border-white/[0.08] bg-[#D90701] p-6 sm:p-8 relative overflow-hidden"
          >
            <div class="absolute inset-0 opacity-10" aria-hidden="true">
              <div
                class="absolute -top-24 -right-24 w-48 h-48 bg-white rounded-full blur-3xl"
              >
              </div>
            </div>
            <div class="relative">
              <h3 class="text-lg font-semibold text-white mb-2">Get the app</h3>
              <p class="text-sm text-white/70 mb-4">
                The best way to experience Giftly Lists.
              </p>
              <a
                href="https://apps.apple.com/us/app/giftly-lists-shared-lists/id6779746364"
                class="inline-flex items-center gap-2 bg-white hover:bg-gray-100 text-black px-5 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 active:scale-[0.98]"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
                  ></path>
                </svg>
                Download
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick links (same pattern as support page) -->
      <div class="mt-8 grid sm:grid-cols-2 gap-4">
        <a
          href="/support/"
          class="flex items-center gap-4 p-5 bg-white/[0.02] border border-white/[0.06] rounded-xl hover:bg-white/[0.04] hover:border-white/[0.1] transition-all duration-200 group"
        >
          <div
            class="w-10 h-10 bg-white/[0.03] border border-white/[0.06] rounded-xl flex items-center justify-center flex-shrink-0 group-hover:border-[#D90701]/20 group-hover:bg-[#D90701]/[0.03] transition-all duration-300"
          >
            <svg
              class="w-5 h-5 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-white mb-1">Help & FAQ</h3>
            <p class="text-xs text-gray-500">
              Find answers to common questions
            </p>
          </div>
          <svg
            class="w-4 h-4 text-gray-600 ml-auto group-hover:text-[#D90701] transition-colors duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="/"
          class="flex items-center gap-4 p-5 bg-white/[0.02] border border-white/[0.06] rounded-xl hover:bg-white/[0.04] hover:border-white/[0.1] transition-all duration-200 group"
        >
          <div
            class="w-10 h-10 bg-white/[0.03] border border-white/[0.06] rounded-xl flex items-center justify-center flex-shrink-0 group-hover:border-[#D90701]/20 group-hover:bg-[#D90701]/[0.03] transition-all duration-300"
          >
            <svg
              class="w-5 h-5 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-medium text-white mb-1">Back to Home</h3>
            <p class="text-xs text-gray-500">Return to the main page</p>
          </div>
          <svg
            class="w-4 h-4 text-gray-600 ml-auto group-hover:text-[#D90701] transition-colors duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Base>
