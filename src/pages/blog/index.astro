---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const PAGE1_GRID_SIZE = 9;
const PAGE_SIZE = 12;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featuredPost, ...rest] = posts;
const gridPosts = rest.slice(0, PAGE1_GRID_SIZE);
const remaining = rest.slice(PAGE1_GRID_SIZE);
const totalPages = 1 + Math.ceil(remaining.length / PAGE_SIZE);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title="Gift Ideas & Wishlist Tips | Giftly Lists Blog"
  description="Gift guides, wishlist tips, and ideas for birthdays, holidays, weddings, and more from Giftly Lists."
  canonicalPath="/blog/"
>
  <!-- Blog + ItemList structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      name: "Giftly Lists Blog",
      description:
        "Gift guides, wishlist tips, and ideas for birthdays, holidays, weddings, and more.",
      url: "https://giftlylists.com/blog/",
      publisher: {
        "@type": "Organization",
        name: "Giftly Lists",
        url: "https://giftlylists.com/",
      },
      blogPost: [featuredPost, ...gridPosts].map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.pubDate.toISOString(),
        url: `https://giftlylists.com/blog/${post.id}/`,
      })),
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://giftlylists.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: "https://giftlylists.com/blog/",
        },
      ],
    })}
  />

  <!-- Hero / page header -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <div
        class="absolute top-0 left-1/4 w-[800px] h-[800px] bg-[#D90701]/[0.03] rounded-full blur-[120px]"
      >
      </div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-[#D90701] transition-colors duration-200 mb-8 group"
      >
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to home
      </a>

      <p
        class="text-xs font-medium text-gray-500 uppercase tracking-[0.2em] mb-4"
      >
        Blog
      </p>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6 leading-[1.1] max-w-2xl"
      >
        Gift ideas & wishlist tips
      </h1>
      <p class="text-lg sm:text-xl text-gray-500 leading-relaxed max-w-xl">
        Guides, gift guides, and practical tips for keeping every occasion a
        surprise — from birthdays to weddings to holidays.
      </p>
    </div>
  </section>

  {
    posts.length === 0 && (
      <section class="relative py-24">
        <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <p class="text-gray-500">
            New posts are on the way — check back soon.
          </p>
        </div>
      </section>
    )
  }

  <!-- Featured post -->
  {
    featuredPost && (
      <section class="relative pb-16 sm:pb-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <a
            href={`/blog/${featuredPost.id}/`}
            class="group grid lg:grid-cols-2 gap-0 rounded-3xl overflow-hidden border border-white/[0.08] bg-white/[0.02] hover:border-white/[0.15] transition-all duration-300"
          >
            <div class="aspect-[16/10] lg:aspect-auto overflow-hidden bg-white/[0.03]">
              {featuredPost.data.heroImage ? (
                <Image
                  src={featuredPost.data.heroImage}
                  alt={featuredPost.data.title}
                  width={900}
                  height={675}
                  class="w-full h-full object-cover grayscale-[15%] contrast-[1.05] group-hover:scale-[1.02] transition-transform duration-500"
                />
              ) : (
                <div
                  class="w-full h-full flex items-center justify-center text-5xl"
                  aria-hidden="true"
                >
                  🎁
                </div>
              )}
            </div>

            <div class="p-8 sm:p-12 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-medium text-[#D90701] uppercase tracking-[0.15em]">
                  Latest
                </span>
                <span
                  class="w-1 h-1 rounded-full bg-gray-700"
                  aria-hidden="true"
                />
                <time
                  datetime={featuredPost.data.pubDate.toISOString()}
                  class="text-xs text-gray-600 uppercase tracking-wide"
                >
                  {formatDate(featuredPost.data.pubDate)}
                </time>
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 leading-tight group-hover:text-[#D90701] transition-colors duration-200">
                {featuredPost.data.title}
              </h2>
              <p class="text-gray-500 leading-relaxed mb-6">
                {featuredPost.data.description}
              </p>

              {featuredPost.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6">
                  {featuredPost.data.tags.map((tag) => (
                    <span class="text-xs text-gray-500 bg-white/[0.04] border border-white/[0.06] rounded-full px-3 py-1">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <span class="inline-flex items-center gap-2 text-sm font-medium text-white">
                Read the post
                <svg
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- Post grid -->
  {
    gridPosts.length > 0 && (
      <section class="relative pb-16 sm:pb-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-sm font-medium text-gray-500 uppercase tracking-[0.15em]">
              More posts
            </h2>
            <span class="text-sm text-gray-600">
              {rest.length} article{rest.length === 1 ? "" : "s"}
            </span>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/[0.04] rounded-2xl overflow-hidden">
            {gridPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex flex-col bg-black hover:bg-white/[0.02] transition-colors duration-300"
              >
                <div class="aspect-[16/10] overflow-hidden bg-white/[0.03]">
                  {post.data.heroImage ? (
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width={500}
                      height={310}
                      class="w-full h-full object-cover grayscale-[15%] contrast-[1.05] group-hover:scale-[1.03] transition-transform duration-500"
                    />
                  ) : (
                    <div
                      class="w-full h-full flex items-center justify-center text-3xl"
                      aria-hidden="true"
                    >
                      🎁
                    </div>
                  )}
                </div>

                <div class="p-6 sm:p-8 flex flex-col flex-1">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-gray-600 uppercase tracking-wide mb-2"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <h3 class="text-lg font-semibold text-white mb-2 leading-snug group-hover:text-[#D90701] transition-colors duration-200">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-gray-500 leading-relaxed line-clamp-3">
                    {post.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Pagination -->
  {
    totalPages > 1 && (
      <section class="relative pb-16 sm:pb-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <nav
            aria-label="Blog pagination"
            class="flex items-center justify-center gap-2"
          >
            <span
              aria-disabled="true"
              class="px-4 py-2 rounded-lg text-sm text-gray-700 cursor-not-allowed select-none"
            >
              Previous
            </span>

            {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
              <a
                href={n === 1 ? "/blog/" : `/blog/${n}/`}
                aria-current={n === 1 ? "page" : undefined}
                class={
                  n === 1
                    ? "px-4 py-2 rounded-lg text-sm font-medium bg-[#D90701] text-white"
                    : "px-4 py-2 rounded-lg text-sm text-gray-500 hover:text-white hover:bg-white/[0.04] transition-colors duration-200"
                }
              >
                {n}
              </a>
            ))}

            <a
              href="/blog/2/"
              class="px-4 py-2 rounded-lg text-sm text-gray-500 hover:text-white hover:bg-white/[0.04] transition-colors duration-200"
            >
              Next
            </a>
          </nav>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="relative pb-24 sm:pb-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="bg-[#D90701] border border-[#D90701] rounded-2xl p-8 sm:p-12 relative overflow-hidden"
      >
        <div class="absolute inset-0 opacity-10" aria-hidden="true">
          <div
            class="absolute -top-24 -right-24 w-48 h-48 bg-white rounded-full blur-3xl"
          >
          </div>
        </div>
        <div
          class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-6"
        >
          <div>
            <h2 class="text-2xl font-semibold text-white mb-2">
              Ready to make your next list?
            </h2>
            <p class="text-white/70 text-sm leading-relaxed">
              Free to start. No credit card required.
            </p>
          </div>

          <a
            href="https://apps.apple.com/us/app/giftly-lists-shared-lists/id6779746364"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-100 text-black px-6 py-3 rounded-xl font-medium text-sm transition-all duration-200 active:scale-[0.98] whitespace-nowrap"
          >
            Download on the App Store
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
