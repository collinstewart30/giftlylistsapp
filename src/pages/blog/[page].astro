---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

type PageData = {
  data: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
  url: { current: string; prev?: string; next?: string };
};

export const getStaticPaths = (async () => {
  const PAGE1_GRID_SIZE = 9;
  const PAGE_SIZE = 12;

  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // index.astro already shows 1 featured + PAGE1_GRID_SIZE grid posts as "page 1".
  // Everything here is what's left, and it starts at site page 2.
  const remaining = posts.slice(1 + PAGE1_GRID_SIZE);
  const extraPageCount = Math.ceil(remaining.length / PAGE_SIZE);
  const lastPage = 1 + extraPageCount; // +1 to account for index.astro as page 1

  return Array.from({ length: extraPageCount }, (_, i) => {
    const currentPage = i + 2; // first generated page is site page 2
    const start = i * PAGE_SIZE;
    const data = remaining.slice(start, start + PAGE_SIZE);

    const props: PageData = {
      data,
      currentPage,
      lastPage,
      url: {
        current: `/blog/${currentPage}/`,
        prev: currentPage === 2 ? "/blog/" : `/blog/${currentPage - 1}/`,
        next: currentPage < lastPage ? `/blog/${currentPage + 1}/` : undefined,
      },
    };

    return {
      params: { page: String(currentPage) },
      props,
    };
  });
}) satisfies GetStaticPaths;

const { data, currentPage, lastPage, url } = Astro.props as PageData;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title={`Gift Ideas & Wishlist Tips | Page ${currentPage} | Giftly Lists Blog`}
  description="Gift guides, wishlist tips, and ideas for birthdays, holidays, weddings, and more from Giftly Lists."
  canonicalPath={`/blog/${currentPage}/`}
>
  <section class="relative pb-16 sm:pb-20 pt-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/[0.04] rounded-2xl overflow-hidden"
      >
        {
          data.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="group flex flex-col bg-black hover:bg-white/[0.02] transition-colors duration-300"
            >
              <div class="aspect-[16/10] overflow-hidden bg-white/[0.03]">
                {post.data.heroImage ? (
                  <Image
                    src={post.data.heroImage}
                    alt={post.data.title}
                    width={500}
                    height={310}
                    class="w-full h-full object-cover grayscale-[15%] contrast-[1.05] group-hover:scale-[1.03] transition-transform duration-500"
                  />
                ) : (
                  <div
                    class="w-full h-full flex items-center justify-center text-3xl"
                    aria-hidden="true"
                  >
                    🎁
                  </div>
                )}
              </div>
              <div class="p-6 sm:p-8 flex flex-col flex-1">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-xs text-gray-600 uppercase tracking-wide mb-2"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <h3 class="text-lg font-semibold text-white mb-2 leading-snug group-hover:text-[#D90701] transition-colors duration-200">
                  {post.data.title}
                </h3>
                <p class="text-sm text-gray-500 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <nav
        aria-label="Blog pagination"
        class="flex items-center justify-center gap-2 mt-12"
      >
        {
          url.prev ? (
            <a
              href={url.prev}
              class="px-4 py-2 rounded-lg text-sm text-gray-500 hover:text-white hover:bg-white/[0.04] transition-colors duration-200"
            >
              Previous
            </a>
          ) : (
            <span
              aria-disabled="true"
              class="px-4 py-2 rounded-lg text-sm text-gray-700 cursor-not-allowed select-none"
            >
              Previous
            </span>
          )
        }

        {
          Array.from({ length: lastPage }, (_, i) => i + 1).map((n) => (
            <a
              href={n === 1 ? "/blog/" : `/blog/${n}/`}
              aria-current={n === currentPage ? "page" : undefined}
              class={
                n === currentPage
                  ? "px-4 py-2 rounded-lg text-sm font-medium bg-[#D90701] text-white"
                  : "px-4 py-2 rounded-lg text-sm text-gray-500 hover:text-white hover:bg-white/[0.04] transition-colors duration-200"
              }
            >
              {n}
            </a>
          ))
        }

        {
          url.next ? (
            <a
              href={url.next}
              class="px-4 py-2 rounded-lg text-sm text-gray-500 hover:text-white hover:bg-white/[0.04] transition-colors duration-200"
            >
              Next
            </a>
          ) : (
            <span
              aria-disabled="true"
              class="px-4 py-2 rounded-lg text-sm text-gray-700 cursor-not-allowed select-none"
            >
              Next
            </span>
          )
        }
      </nav>
    </div>
  </section>
</Base>
