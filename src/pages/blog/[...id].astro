---
// src/blog/[id].astro
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title={`${post.data.title} | Giftly Lists Blog`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
>
  <!-- BlogPosting structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      url: `https://giftlylists.com/blog/${post.id}/`,
      publisher: {
        "@type": "Organization",
        name: "Giftly Lists",
        url: "https://giftlylists.com/",
      },
      author: {
        "@type": "Person",
        name: "Giftly Lists Team",
      },
    })}
  />

  <!-- BreadcrumbList structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://giftlylists.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: "https://giftlylists.com/blog/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: `https://giftlylists.com/blog/${post.id}/`,
        },
      ],
    })}
  />

  <article class="relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute inset-0" aria-hidden="true">
      <div
        class="absolute top-0 left-1/4 w-[800px] h-[800px] bg-[#D90701]/[0.03] rounded-full blur-[120px]"
      >
      </div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20">
      <!-- Back to blog -->
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-[#D90701] transition-colors duration-200 mb-8 group"
      >
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to blog
      </a>

      <div class="max-w-4xl">
        <!-- Blog label (matching index hero) -->
        <p
          class="text-xs font-medium text-gray-500 uppercase tracking-[0.2em] mb-4"
        >
          Blog
        </p>

        <!-- Title -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-[1.08]"
        >
          {post.data.title}
        </h1>

        <!-- Publication date -->
        <time
          datetime={post.data.pubDate.toISOString()}
          class="block text-xs text-gray-600 uppercase tracking-wide mt-4"
        >
          {formatDate(post.data.pubDate)}
        </time>

        <!-- Description -->
        <p
          class="text-lg sm:text-xl text-gray-500 mt-6 leading-relaxed max-w-3xl"
        >
          {post.data.description}
        </p>

        <!-- Tags -->
        {
          post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-8">
              {post.data.tags.map((tag) => (
                <span class="text-xs text-gray-500 bg-white/[0.04] border border-white/[0.06] rounded-full px-3 py-1">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      <!-- Hero image -->
      {
        post.data.heroImage && (
          <div class="mt-14 rounded-3xl overflow-hidden border border-white/[0.08] bg-white/[0.02]">
            <Image
              src={post.data.heroImage}
              alt={post.data.title}
              width={1200}
              height={700}
              class="w-full object-cover"
            />
          </div>
        )
      }

      <!-- Article content card -->
      <div
        class="mt-16 rounded-3xl border border-white/[0.08] bg-white/[0.02] p-8 sm:p-12 lg:p-16"
      >
        <div
          class="prose prose-invert prose-lg lg:prose-xl max-w-none
                 prose-headings:text-white
                 prose-p:text-gray-300
                 prose-li:text-gray-300
                 prose-strong:text-white
                 prose-a:text-[#D90701]
                 prose-a:no-underline hover:prose-a:underline
                 prose-code:text-white
                 prose-pre:bg-black/40"
        >
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- CTA (identical to index page) -->
  <section class="relative pb-24 sm:pb-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="bg-[#D90701] border border-[#D90701] rounded-2xl p-8 sm:p-12 relative overflow-hidden"
      >
        <div class="absolute inset-0 opacity-10" aria-hidden="true">
          <div
            class="absolute -top-24 -right-24 w-48 h-48 bg-white rounded-full blur-3xl"
          >
          </div>
        </div>
        <div
          class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-6"
        >
          <div>
            <h2 class="text-2xl font-semibold text-white mb-2">
              Ready to make your next list?
            </h2>
            <p class="text-white/70 text-sm leading-relaxed">
              Free to start. No credit card required.
            </p>
          </div>
          <a
            href="https://apps.apple.com/us/app/giftly-lists-shared-lists/id6779746364"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-100 text-black px-6 py-3 rounded-xl font-medium text-sm transition-all duration-200 active:scale-[0.98] whitespace-nowrap"
          >
            Download on the App Store
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
